// This kernel initializes interesting full texture seeds
#pragma kernel InitFullTexture

[numthreads(8, 8, 1)]
void InitFullTexture(uint3 id : SV_DispatchThreadID)
{
    // Interesting full texture init patterns
    
    if (id.x % 7 == 0 || id.y % 3 == 0)
        State1[id.xy] = CellColour;

    /*if (id.x % 10 == 0 || id.y % 5 == 0)
        State1[id.xy] = CellColour;*/
}

// We're using 2 states for maximum simulation integrity

#pragma kernel Update1

[numthreads(8, 8, 1)]
void Update1 (uint3 id : SV_DispatchThreadID)
{
    UpdateCell(State1, State2, id.xy);
}

#pragma kernel Update2

[numthreads(8, 8, 1)]
void Update2 (uint3 id : SV_DispatchThreadID)
{
    UpdateCell(State2, State1, id.xy);
}